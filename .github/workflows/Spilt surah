name: Split Suras into Separate Files

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  split-suras-job:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Run split_suras.py script
        run: python split_suras.py

      - name: Commit and Push sura files
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add suras/
          git status
          git diff-index --quiet HEAD || git commit -m "Auto-generate 114 separate sura JSON files"
          git push
